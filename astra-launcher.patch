diff --git a/launcher/ui/themes/AstraTheme.cpp b/launcher/ui/themes/AstraTheme.cpp
new file mode 100644
index 0000000..9e3f450
--- /dev/null
+++ b/launcher/ui/themes/AstraTheme.cpp
@@ -0,0 +1,169 @@
+// SPDX-License-Identifier: GPL-3.0-only
+/*
+ *  Astra Launcher - a Prism Launcher fork
+ *
+ *  This program is free software: you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License as published by
+ *  the Free Software Foundation, version 3.
+ */
+
+#include "AstraTheme.h"
+
+#include <QObject>
+
+std::vector<AstraTheme::Variant> AstraTheme::variants()
+{
+    // id, name, window, base, surface, accent, text - all deliberately dark
+    return {
+        { "astra_amethyst", QObject::tr("Astra Amethyst"), QColor(14, 11, 22), QColor(20, 16, 31), QColor(31, 25, 46), QColor(167, 139, 250),
+          QColor(234, 230, 245) },
+        { "astra_midnight", QObject::tr("Astra Midnight"), QColor(9, 12, 20), QColor(14, 19, 31), QColor(23, 30, 47), QColor(108, 140, 255),
+          QColor(228, 234, 248) },
+        { "astra_obsidian", QObject::tr("Astra Obsidian"), QColor(9, 9, 11), QColor(16, 16, 19), QColor(27, 27, 32), QColor(212, 212, 220),
+          QColor(236, 236, 240) },
+        { "astra_abyss", QObject::tr("Astra Abyss"), QColor(5, 11, 16), QColor(9, 19, 26), QColor(16, 31, 40), QColor(45, 212, 191),
+          QColor(224, 240, 240) },
+        { "astra_crimson", QObject::tr("Astra Crimson"), QColor(16, 8, 10), QColor(25, 12, 16), QColor(40, 20, 26), QColor(244, 63, 94),
+          QColor(244, 230, 233) },
+        { "astra_emerald", QObject::tr("Astra Emerald"), QColor(7, 15, 11), QColor(11, 24, 18), QColor(18, 37, 28), QColor(52, 211, 153),
+          QColor(226, 242, 234) },
+        { "astra_ember", QObject::tr("Astra Ember"), QColor(17, 11, 7), QColor(27, 17, 11), QColor(43, 27, 18), QColor(251, 146, 60),
+          QColor(246, 236, 228) },
+    };
+}
+
+QPalette AstraTheme::colorScheme()
+{
+    QPalette p;
+    p.setColor(QPalette::Window, m_v.window);
+    p.setColor(QPalette::WindowText, m_v.text);
+    p.setColor(QPalette::Base, m_v.base);
+    p.setColor(QPalette::AlternateBase, m_v.base.lighter(112));
+    p.setColor(QPalette::ToolTipBase, m_v.surface);
+    p.setColor(QPalette::ToolTipText, m_v.text);
+    p.setColor(QPalette::Text, m_v.text);
+    p.setColor(QPalette::Button, m_v.surface);
+    p.setColor(QPalette::ButtonText, m_v.text);
+    p.setColor(QPalette::BrightText, QColor(255, 107, 122));
+    p.setColor(QPalette::Link, m_v.accent);
+    p.setColor(QPalette::Highlight, m_v.accent);
+    p.setColor(QPalette::HighlightedText, m_v.accent.lightness() > 170 ? QColor(12, 12, 16) : QColor(255, 255, 255));
+    p.setColor(QPalette::PlaceholderText, QColor(m_v.text.red(), m_v.text.green(), m_v.text.blue(), 110));
+    p.setColor(QPalette::Mid, m_v.surface.lighter(130));
+    p.setColor(QPalette::Dark, m_v.window.darker(130));
+    p.setColor(QPalette::Light, m_v.surface.lighter(160));
+    return fadeInactive(p, fadeAmount(), fadeColor());
+}
+
+static QString rgba(const QColor& c, double a)
+{
+    return QString("rgba(%1, %2, %3, %4)").arg(c.red()).arg(c.green()).arg(c.blue()).arg(qBound(0, int(a * 255), 255));
+}
+
+QString AstraTheme::appStyleSheet()
+{
+    const QColor& w = m_v.window;
+    const QColor& b = m_v.base;
+    const QColor& s = m_v.surface;
+    const QColor& a = m_v.accent;
+    const QColor& t = m_v.text;
+    const QColor white(255, 255, 255);
+    QString onAccent = a.lightness() > 170 ? "#0c0c10" : "#ffffff";
+
+    QString css = R"(
+/* ---- Astra glass ---- */
+QMainWindow, QDialog { background-color: %WIN%; }
+QToolTip { color: %TEXT%; background-color: %SURF%; border: 1px solid %EDGE%; border-radius: 8px; padding: 5px 8px; }
+
+QToolBar { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 %SURF_A%, stop:1 %WIN_A%);
+           border: none; border-bottom: 1px solid %EDGE_SOFT%; padding: 4px; spacing: 4px; }
+QToolBar::separator { background: %EDGE_SOFT%; width: 1px; margin: 6px 4px; }
+QToolButton { background: transparent; border: 1px solid transparent; border-radius: 9px; padding: 5px 8px; color: %TEXT%; }
+QToolButton:hover { background: %GLASS_HOVER%; border-color: %EDGE%; }
+QToolButton:pressed, QToolButton:checked { background: %ACCENT_SOFT%; border-color: %ACCENT_EDGE%; }
+
+QPushButton { background: %GLASS%; color: %TEXT%; border: 1px solid %EDGE%; border-radius: 9px; padding: 6px 14px; min-height: 18px; }
+QPushButton:hover { background: %GLASS_HOVER%; border-color: %EDGE_STRONG%; }
+QPushButton:pressed { background: %ACCENT_SOFT%; border-color: %ACCENT_EDGE%; }
+QPushButton:default { background: %ACCENT%; color: %ON_ACCENT%; border: 1px solid %ACCENT%; }
+QPushButton:default:hover { background: %ACCENT_LIGHT%; }
+QPushButton:disabled { color: %TEXT_DIM%; background: %GLASS_DIM%; border-color: %EDGE_SOFT%; }
+QPushButton:focus { border-color: %ACCENT_EDGE%; }
+QPushButton::menu-indicator { subcontrol-position: right center; right: 6px; }
+
+QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit, QTextEdit, QKeySequenceEdit {
+    background: %BASE_A%; color: %TEXT%; border: 1px solid %EDGE%; border-radius: 8px; padding: 4px 8px;
+    selection-background-color: %ACCENT%; selection-color: %ON_ACCENT%; }
+QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus { border-color: %ACCENT_EDGE%; }
+QComboBox::drop-down { border: none; width: 20px; }
+QComboBox QAbstractItemView { background: %SURF%; border: 1px solid %EDGE%; border-radius: 8px; padding: 4px;
+    selection-background-color: %ACCENT_SOFT%; selection-color: %TEXT%; outline: none; }
+
+QTreeView, QTableView, QListWidget, QTreeWidget, QTextBrowser {
+    background: %BASE_A%; border: 1px solid %EDGE_SOFT%; border-radius: 12px; outline: none;
+    selection-background-color: %ACCENT_SOFT%; selection-color: %TEXT%; alternate-background-color: %ALT%; }
+QListView { border: 1px solid %EDGE_SOFT%; border-radius: 12px; outline: none;
+    selection-background-color: %ACCENT_SOFT%; selection-color: %TEXT%; }
+QTreeView::item, QListView::item, QTableView::item { border-radius: 6px; padding: 3px; }
+QTreeView::item:hover, QListView::item:hover { background: %GLASS_HOVER%; }
+QTreeView::item:selected, QListView::item:selected, QTableView::item:selected { background: %ACCENT_SOFT%; color: %TEXT%; }
+QHeaderView::section { background: %SURF%; color: %TEXT_DIM%; border: none; border-bottom: 1px solid %EDGE_SOFT%; padding: 5px 8px; }
+/* the instance grid paints its own background art - keep it see-through */
+InstanceView { background: transparent; border: none; }
+
+QTabWidget::pane { border: 1px solid %EDGE_SOFT%; border-radius: 12px; background: %BASE_A%; top: -1px; }
+QTabBar::tab { background: transparent; color: %TEXT_DIM%; border: 1px solid transparent; border-radius: 8px; padding: 6px 12px; margin: 2px; }
+QTabBar::tab:hover { background: %GLASS_HOVER%; color: %TEXT%; }
+QTabBar::tab:selected { background: %ACCENT_SOFT%; color: %TEXT%; border-color: %ACCENT_EDGE%; }
+
+QGroupBox { border: 1px solid %EDGE_SOFT%; border-radius: 12px; margin-top: 14px; padding: 10px 8px 8px 8px; background: %GLASS_DIM%; }
+QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 4px; color: %TEXT%; }
+
+QMenuBar { background: %WIN%; }
+QMenuBar::item { padding: 4px 10px; border-radius: 6px; }
+QMenuBar::item:selected { background: %GLASS_HOVER%; }
+QMenu { background: %SURF%; border: 1px solid %EDGE%; border-radius: 10px; padding: 5px; }
+QMenu::item { padding: 6px 22px 6px 12px; border-radius: 6px; }
+QMenu::item:selected { background: %ACCENT_SOFT%; }
+QMenu::separator { height: 1px; background: %EDGE_SOFT%; margin: 4px 8px; }
+
+QProgressBar { background: %BASE_A%; border: 1px solid %EDGE_SOFT%; border-radius: 7px; text-align: center; color: %TEXT%; min-height: 14px; }
+QProgressBar::chunk { border-radius: 6px; background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 %ACCENT%, stop:1 %ACCENT_LIGHT%); }
+
+QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
+QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
+QScrollBar::handle:vertical { background: %EDGE_STRONG%; border-radius: 3px; min-height: 28px; margin: 0 2px; }
+QScrollBar::handle:horizontal { background: %EDGE_STRONG%; border-radius: 3px; min-width: 28px; margin: 2px 0; }
+QScrollBar::handle:hover { background: %ACCENT_EDGE%; }
+QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
+QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
+
+QSlider::groove:horizontal { height: 4px; background: %EDGE_SOFT%; border-radius: 2px; }
+QSlider::sub-page:horizontal { background: %ACCENT%; border-radius: 2px; }
+QSlider::handle:horizontal { background: #ffffff; width: 12px; margin: -5px 0; border-radius: 6px; }
+
+QStatusBar { background: %WIN%; border-top: 1px solid %EDGE_SOFT%; }
+QSplitter::handle { background: transparent; }
+QCheckBox, QRadioButton { spacing: 6px; }
+)";
+    css.replace("%WIN_A%", rgba(w, 0.96))
+        .replace("%WIN%", w.name())
+        .replace("%BASE_A%", rgba(b, 0.92))
+        .replace("%ALT%", rgba(b.lighter(115), 0.92))
+        .replace("%SURF_A%", rgba(s, 0.85))
+        .replace("%SURF%", s.name())
+        .replace("%GLASS_HOVER%", rgba(white, 0.09))
+        .replace("%GLASS_DIM%", rgba(white, 0.025))
+        .replace("%GLASS%", rgba(white, 0.055))
+        .replace("%EDGE_STRONG%", rgba(white, 0.22))
+        .replace("%EDGE_SOFT%", rgba(white, 0.07))
+        .replace("%EDGE%", rgba(white, 0.12))
+        .replace("%ACCENT_SOFT%", rgba(a, 0.24))
+        .replace("%ACCENT_EDGE%", rgba(a, 0.70))
+        .replace("%ACCENT_LIGHT%", a.lighter(118).name())
+        .replace("%ACCENT%", a.name())
+        .replace("%ON_ACCENT%", onAccent)
+        .replace("%TEXT_DIM%", rgba(t, 0.55))
+        .replace("%TEXT%", t.name());
+    return css;
+}
diff --git a/launcher/ui/themes/AstraTheme.h b/launcher/ui/themes/AstraTheme.h
new file mode 100644
index 0000000..60a6227
--- /dev/null
+++ b/launcher/ui/themes/AstraTheme.h
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: GPL-3.0-only
+/*
+ *  Astra Launcher - a Prism Launcher fork
+ *
+ *  This program is free software: you can redistribute it and/or modify
+ *  it under the terms of the GNU General Public License as published by
+ *  the Free Software Foundation, version 3.
+ */
+
+#pragma once
+
+#include <QColor>
+#include <QObject>
+#include <QPalette>
+#include <QString>
+#include <vector>
+#include "FusionTheme.h"
+
+/**
+ * Astra's dark glass themes: deep backgrounds, translucent rounded surfaces, hairline edges and one accent colour -
+ * the same look as the Astra DLC menus. Every variant is a palette + one shared stylesheet.
+ */
+class AstraTheme : public FusionTheme {
+   public:
+    struct Variant {
+        QString id;
+        QString name;
+        QColor window;   // page background
+        QColor base;     // lists / fields
+        QColor surface;  // buttons / cards
+        QColor accent;   // selection, focus, default button
+        QColor text;
+    };
+
+    explicit AstraTheme(Variant v) : m_v(std::move(v)) {}
+    virtual ~AstraTheme() {}
+
+    static std::vector<Variant> variants();
+
+    QString id() override { return m_v.id; }
+    QString name() override { return m_v.name; }
+    QString tooltip() override { return QObject::tr("Astra dark glass theme"); }
+    bool hasStyleSheet() override { return true; }
+    QString appStyleSheet() override;
+    QPalette colorScheme() override;
+    double fadeAmount() override { return 0.5; }
+    QColor fadeColor() override { return m_v.window; }
+
+   private:
+    Variant m_v;
+};
